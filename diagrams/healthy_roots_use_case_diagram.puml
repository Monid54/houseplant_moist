@startuml Healthy_Roots_Use_Case_Diagram

title Healthy Roots @ Home - Use Case Diagram

skinparam actorStyle awesome
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam usecaseBorderColor #444444
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseFontSize 10
skinparam actorFontSize 10
skinparam ArrowColor #555555
skinparam ArrowFontSize 9
skinparam defaultFontName Arial

top to bottom direction

actor "Plant Owner\n(User)" as Owner #DAE8FC
actor "ESP32-C3\nSensor Node" as ESP32 <<device>> #D5E8D4
actor "Systemd Timer\n(nightly)" as Systemd <<system>> #FFF2CC
actor "System\nAdministrator" as Admin <<secondary>> #F8CECC

rectangle "Healthy Roots @ Home System" {

  package "Web Frontend" #DAE8FC {
    usecase "UC8: Login / Create Account\n(Planned - Future)" as UC8
    usecase "UC9: View Dashboard" as UC9
    usecase "UC10: View Moisture\nChart (last 24h)" as UC10
    usecase "UC11: Check Plant\nStatus Card" as UC11
  }

  package "Sensor & Transmission" #D5E8D4 {
    usecase "UC1: Measure Soil Moisture\n(every 15 min)" as UC1
    usecase "UC2: Transmit Data\n(HTTP POST /ingest)" as UC2
    usecase "UC3: Retry Failed\nTransmission (up to 3x)" as UC3
  }

  package "Data Export & Sync" #FFF2CC {
    usecase "UC6: Export Data to JSON\n(latest.json + daily/)" as UC6
    usecase "UC7: Push Exports\nto GitHub" as UC7
  }

  package "Administration" #F8CECC {
    usecase "UC12: Deploy Backend\n(FastAPI on Pi)" as UC12
    usecase "UC13: Manage\nDatabase (SQLite)" as UC13
    usecase "UC14: Configure\nSensors & Calibration" as UC14
  }

  package "Backend" #FFF9C4 {
    usecase "UC4: Validate &\nStore Reading" as UC4
    usecase "UC5: Serve Readings\n(GET /readings, /latest)" as UC5
  }

}

' ESP32
ESP32 --> UC2
ESP32 --> UC1
ESP32 --> UC3
UC1 .> UC2 : <<include>>
UC2 <. UC3 : <<extend>>
UC2 .down.> UC4 : <<include>>

'Backend
UC9 <.down. UC5 : <<include>>
UC5 <.up. UC12 : <<include>>
UC5 <.up. UC13 : <<extend>>

' Systemd Timer
Systemd --> UC6
UC6 .> UC7 : <<include>>

' Plant Owner
UC8 -[hidden]right-> UC9
UC9 -[hidden]right-> UC10
UC10 -[hidden]right-> UC11
Owner --> UC8
Owner --> UC9
UC9 .> UC10 : <<include>>
UC9 .> UC11 : <<include>>

' Admin
Admin --> UC12
Admin --> UC13
Admin --> UC14
UC12 .> UC13 : <<include>>

@enduml