@startuml Healthy_Roots_Use_Case_Diagram

title Healthy Roots @ Home – Use Case Diagram

skinparam actorStyle awesome
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam usecaseBorderColor #444444
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseFontSize 10
skinparam usecaseStereotypeFontSize 9
skinparam actorFontSize 10
skinparam ArrowColor #555555
skinparam ArrowFontSize 9
skinparam defaultFontName Arial
skinparam pageMargin 10
skinparam padding 2

' 4:3 landscape layout: wide, actors on far left and right
left to right direction

' ─────────────────────────────────────────
' Actors – left column
' ─────────────────────────────────────────
actor "Plant Owner\n(User)" as Owner #DAE8FC
actor "ESP32-C3\nSensor Node" as ESP32 <<device>> #D5E8D4
actor "Systemd Timer" as Timer <<system>> #FFF2CC
actor "System\nAdministrator" as Admin <<secondary>> #F8CECC

' ─────────────────────────────────────────
' System boundary
' ─────────────────────────────────────────
rectangle "Healthy Roots @ Home System" {

  ' Row 1 – top
  package "Sensor & Transmission" #D5E8D4 {
    usecase "UC1: Measure Soil Moisture\n(every 15 min)" as UC1
    usecase "UC2: Transmit Data\n(HTTP POST /ingest)" as UC2
    usecase "UC3: Validate and\nStore Reading" as UC3
    usecase "UC4: Retry Failed\nTransmission (up to 3x)" as UC4
    usecase "UC5: Reconnect Wi-Fi\n(on connection loss)" as UC5
  }

  ' Row 2 – middle left
  package "Data Export & Sync" #FFF2CC {
    usecase "UC6: Export Data to JSON\n(latest.json + daily/)" as UC6
    usecase "UC7: Push Exports\nto GitHub" as UC7
  }

  ' Row 2 – middle right
  package "Web Frontend (PlantCare)" #DAE8FC {
    usecase "UC8: Sign Up\n(multi-step)" as UC8
    usecase "UC9: Log In\n(email / Google)" as UC9
    usecase "UC10: View Dashboard" as UC10
    usecase "UC11: View Moisture\nChart (last 24h)" as UC11
    usecase "UC12: Check Plant\nStatus Card" as UC12
    usecase "UC13: Toggle\nDark Mode" as UC13
    usecase "UC14: Query Readings\nvia API" as UC14
  }

  ' Row 3 – bottom left
  package "Administration" #F8CECC {
    usecase "UC15: Configure\nSensors & Calibration" as UC15
    usecase "UC16: Deploy Backend\n(FastAPI on Pi)" as UC16
    usecase "UC17: Manage\nDatabase (SQLite)" as UC17
  }

  ' Row 3 – bottom right
  package "Future (FR-8)" #EEEEEE {
    usecase "UC18: Receive Alert\nNotification" as UC18
  }

}

' ─────────────────────────────────────────
' Relationships – ESP32
' ─────────────────────────────────────────
ESP32 --> UC1
ESP32 --> UC2
ESP32 --> UC4
ESP32 --> UC5

UC1 .> UC2 : <<include>>
UC2 .> UC3 : <<include>>
UC2 .> UC4 : <<extend>>\n(on POST failure)
UC5 .> UC2 : <<extend>>\n(after reconnect)

' ─────────────────────────────────────────
' Relationships – Systemd Timer
' ─────────────────────────────────────────
Timer --> UC6
UC6 .> UC7 : <<include>>

' ─────────────────────────────────────────
' Relationships – Plant Owner
' ─────────────────────────────────────────
Owner --> UC8
Owner --> UC9
Owner --> UC10
Owner --> UC13

UC8  .> UC9  : <<extend>>\n(after registration)
UC10 .> UC11 : <<include>>
UC10 .> UC12 : <<include>>
UC10 .> UC13 : <<include>>
UC11 .> UC6  : <<extend>>\n(reads latest.json)
UC12 .> UC14 : <<include>>
UC18 .> UC10 : <<extend>>\n(future alert)

' ─────────────────────────────────────────
' Relationships – Admin
' ─────────────────────────────────────────
Admin --> UC15
Admin --> UC16
Admin --> UC17

UC16 .> UC17 : <<include>>
UC15 .> UC3  : <<extend>>\n(affects validation)

@enduml
