@startuml Healthy_Roots_Class_Diagram

title Healthy Roots @ Home – UML Class Diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classHeaderBackgroundColor #DDDDDD
skinparam roundcorner 6
skinparam linetype ortho

' ─────────────────────────────────────────
' ESP32 Firmware
' ─────────────────────────────────────────
package "ESP32 Firmware" #DAECFC {

  class SensorNode {
    - sensorId : String
    - measurementInterval : int = 900
    - maxRetries : int = 3
    - sensor : MoistureSensor
    --
    + setup() : void
    + loop() : void
    + sleepUntilNext(sec : int) : void
  }

  class MoistureSensor {
    - pin : int
    - dry : int = 390
    - wet : int = 630
    - readRaw : int
    - moisturePercentage : int
    --
    + readAveraged(samples : int) : int
    + toPercent(raw : int) : int
    + calibrate() : void
  }

  class WiFiClient {
    - ssid : String
    - password : String
    --
    + connect() : boolean
    + disconnect() : void
    + isConnected() : boolean
    + reconnect() : boolean
    + getRSSI() : int
  }

  class HttpSender {
    - serverUrl : String
    - hostIpFallback : String
    - hostMdns : String
    - port : int = 8080
    - timeout : int = 6000
    --
    + buildUrl() : String
    + postJson(url : String, payload : String) : boolean
  }

  class Measurement {
    - sensorId : String
    - timestamp : String
    - rawValue : int
    - moisture : int
    - rssi : int
    - vcc : float
    --
    + toJSON() : String
    + validate() : boolean
  }

}

' ─────────────────────────────────────────
' Server (Raspberry Pi)
' ─────────────────────────────────────────
package "Server (Raspberry Pi)" #FFF2CC {

  class ReadingIn <<Pydantic BaseModel>> {
    + sensor_id : str  [1..64]
    + raw : Optional[int]  [0..4095]
    + moisture : Optional[int]  [0..100]
    + vcc : Optional[float]
    + rssi : Optional[int]
    + ts : Optional[str]
  }

  class ApiServer {
    - port : int = 8080
    - measurementRepository : MeasurementRepository
    --
    + init() : void
    + start() : void
    + health() : dict
    + ingest(r : ReadingIn) : dict
    + getReadings(sensor_id : str, limit : int) : list
    + latest(sensor_id : str) : dict
  }

  class Sensor {
    - sensorId : String
    - plantName : String
    - location : String
    - registeredAt : Date
    --
    + getLatestMeasurement() : Measurement
    + getAverageMoisture(days : int) : float
  }

  class MeasurementRepository {
    - dbConnection : DatabaseConnection
    --
    + save(data : ReadingIn) : boolean
    + findBySensorId(id : String) : List<Measurement>
    + findByTimeRange(from : double, to : double) : List<Measurement>
    + countBySensorId(sensorId : String) : int
  }

  class DatabaseConnection {
    - dbPath : String
    - connection : SQLiteConnection
    --
    + open() : void
    + close() : void
    + executeQuery(query : String) : ResultSet
  }

  class ExportService {
    - dbPath : Path
    - exportsDir : Path
    - latestDays : int = 14
    --
    + exportLatest() : void
    + exportDaily(day : str) : void
    + aggregateBuckets(rows : list) : list
  }

}

' ─────────────────────────────────────────
' Web Application (future)
' ─────────────────────────────────────────
package "Web Application (future)" #D5E8D4 {

  class NotificationService {
    - thresholdHours : int = 24
    --
    + checkOfflineStatus() : void
    + sendAlertSensor(sensor : Sensor) : void
  }

  class Dashboard {
    - timeRange : String
    - selectedSensor : String
    --
    + showOverview() : void
    + selectSensor(sensorId : String) : void
  }

  class ChartView {
    - timeRange : Range
    --
    + renderData(data : List<Measurement>) : void
    + exportCSV() : File
  }

}

' ─────────────────────────────────────────
' Relationships
' ─────────────────────────────────────────

' ESP32 internal
SensorNode *-- MoistureSensor : contains
SensorNode ..> WiFiClient : uses
SensorNode ..> HttpSender : uses
HttpSender ..> Measurement : creates

' ESP32 → Server
Measurement ..> ApiServer : "HTTP POST /ingest"

' Server internal
ApiServer ..> ReadingIn : validates via
ApiServer --> MeasurementRepository : uses
ApiServer ..> Sensor : observes
MeasurementRepository "1" --> "*" Measurement : has
MeasurementRepository --> DatabaseConnection : persists
ExportService ..> DatabaseConnection : reads

' Future Web App
NotificationService ..> ApiServer : monitors
Dashboard --> ChartView : displays
ChartView ..> ExportService : "queries JSON"

@enduml
