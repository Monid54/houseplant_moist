@startuml Healthy_Roots_Class_Diagram

title Healthy Roots @ Home – UML Class Diagram (Target Design)

note as N1
  Target OOP design.
  Current prototype is procedural:
  sensor_1.ino uses free functions,
  app.py and export_db.py use
  flat FastAPI / script style.
end note

skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classHeaderBackgroundColor #DDDDDD
skinparam roundcorner 6
skinparam linetype ortho

package "ESP32 Firmware" #DAECFC {

  class SensorNode {
    - sensorId : String = "plant1"
    - measurementInterval : int = 900000
    - maxRetries : int = 3
    --
    + setup() : void
    + loop() : void
  }

  class MoistureSensor {
    - pin : int = 3
    - dry : int = 390
    - wet : int = 630
    --
    + readAveraged(samples : int = 12) : int
    + toPercent(raw : int) : int
  }

  class WiFiClient {
    - ssid : String
    - password : String
    --
    + ensureWiFi() : void
    + isConnected() : boolean
  }

  class HttpSender {
    - hostIpFallback : String = "192.168.1.161"
    - hostMdns : String = "plant-hub.local"
    - port : int = 8080
    - timeout : int = 6000
    --
    + buildUrl() : String
    + postJson(url : String, payload : String) : boolean
  }

  class Measurement {
    - sensorId : String
    - raw : int
    - moisture : int
    - rssi : int
    --
    + toJSON() : String
  }

}

package "Server (Raspberry Pi)" #FFF2CC {

  class ReadingIn <<Pydantic BaseModel>> {
    + sensor_id : str
    + raw : Optional[int]
    + moisture : Optional[int]
    + vcc : Optional[float]
    + rssi : Optional[int]
    + ts : Optional[str]
  }

  class ApiServer {
    - port : int = 8080
    --
    + health() : dict
    + ingest(r : ReadingIn) : dict
    + getReadings(sensor_id : str, limit : int) : list
    + latest(sensor_id : str) : dict
  }

  class MeasurementRepository {
    --
    + save(data : ReadingIn) : void
    + findBySensorId(id : str, limit : int) : list
    + findLatest(sensor_id : str) : dict
  }

  class DatabaseConnection {
    - dbPath : Path
    --
    + connect() : Connection
    + initDb() : void
  }

  class ExportService {
    - dbPath : Path
    - latestDays : int = 14
    --
    + exportLatest() : void
    + exportDaily(day : str) : void
    + aggregateBuckets(rows : list) : list
  }

}

package "Web Frontend (Future)" #D5E8D4 {

  class Dashboard {
    --
    + showOverview() : void
  }

  class ChartView {
    --
    + renderData(data : list) : void
  }

  class NotificationService {
    --
    + checkOfflineStatus() : void
    + sendAlert() : void
  }

}

' ESP32 internal
SensorNode *-- MoistureSensor
SensorNode ..> WiFiClient : uses
SensorNode ..> HttpSender : uses
HttpSender ..> Measurement : creates

' ESP32 → Server
Measurement ..> ApiServer : "HTTP POST /ingest"

' Server internal
ApiServer ..> ReadingIn : validates
ApiServer --> MeasurementRepository : uses
MeasurementRepository --> DatabaseConnection : uses
ExportService --> DatabaseConnection : reads

' Future
Dashboard --> ChartView : displays
NotificationService ..> ApiServer : monitors

@enduml